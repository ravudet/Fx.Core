<Project>
  <ItemGroup>
    <GlobalAnalyzerConfigFiles Include="$(PkgStyleGlobalConfig)\content\StyleGlobalConfig.globalconfig" /> <!--$(PkgTestNuget) would normally only be generated if the consumer of the package uses <PackageReference Include="TestNuget" Version="4.0.0" GeneratePathProperty="true" />; however, from [here](https://github.com/NuGet/Home/issues/7851), they will automatically generate that "variable" if the package has a `tools` folder -->
  </ItemGroup>
</Project>
