dotnet_diagnostic.CA1507.severity = warning
dotnet_diagnostic.CA1508.severity = warning # TODO great rule, but you should play around with if it's making builds slower; and if it is making builds slower, can this be the sort of thing that only runs on the "official" build?
dotnet_diagnostic.CA1509.severity = none # TODO i really like this rule in principle, but i hate how the codemetricsconfig.txt needs to be added to the individual projects, so i'm not using that file; if i need to configure anything there, i should enable this rule though; maybe i should go ahead and enable it so that i don't forget to do it if i add the file? since it won't trigger when there's no file anyway...
dotnet_diagnostic.CA1510.severity = warning
dotnet_diagnostic.CA1511.severity = warning
dotnet_diagnostic.CA1512.severity = warning
dotnet_diagnostic.CA1513.severity = warning
dotnet_diagnostic.CA1514.severity = warning
dotnet_diagnostic.CA1515.severity = none # TODO this one is difficult, because i think `internal` should *always* be considered so that there is less surface that potentially leads to breaking change in the future; but enabling this rule for dlls basically means that the entire public api surface has to be justified, which i don't think makes sense; further, i don't really agree with the assessment that exes shouldn't have public stuff; i think it's actually quite convenient for some utilities to have a single exe binary that has all of the apis but also contains a console application to run those utilities
dotnet_diagnostic.CA1516.severity = none # TODO the docs seems just on the cusp of explaining to me what the big deal is; i think this one probably *is* important, but i don't know why

### naming

dotnet_diagnostic.CA1700.severity = warning
dotnet_code_quality.CA1700.api_surface = all
# NOTE: there is no CA1701
# NOTE: there is no CA1702
# NOTE: there is no CA1703
# NOTE: there is no CA1704
# NOTE: there is no CA1705
# NOTE: there is no CA1706
dotnet_diagnostic.CA1707.severity = warning
dotnet_code_quality.CA1707.api_surface = all
dotnet_diagnostic.CA1708.severity = warning
dotnet_code_quality.CA1708.api_surface = all
# NOTE: there is no CA1709
dotnet_diagnostic.CA1710.severity = warning
dotnet_code_quality.CA1710.api_surface = all
dotnet_code_quality.CA1710.additional_required_suffixes = T:System.Collections.ICollection->{}|System.Collections.IDictionary->{}|System.Collections.IEnumerable->{}|System.Collections.Generic.IReadOnlyDictionary<TKey,TValue>->{}|System.Collections.Queue->{}|System.Collections.Stack->{}|System.Collections.Generic.ICollection<T>->{}|System.Collections.Generic.IDictionary<TKey,TValue>->{} # TODO i wonder if there's a way to make this more readable # TODO i have found that stuff that implements the collection types are often "their own thing" and the interface is just convenient because it plugs into a bunch of extensions and stuff, so i'm excluding the collection ones; the other types in the rule (besides stream i guess) and more like language constructs than they are data structures, and those i think make sense to have the name, so that the caller is able to immediately recognize the language constructs; regarding stream, i've not found a case where i've derived stream and wanted to call it something else; being a stream has seemed to be part of the nature of the derived types, there's not something that was its own thing but also happened to be a stream (like is the case for collections); i'm only unclear about System.Data.DataSet and System.Data.DataTable, because i've never used them before; i don't think there's a way to mark only them as error, but i could configure the rule so that those have absolutely weird names that are really TODOs 
dotnet_diagnostic.CA1710.severity = warning
dotnet_code_quality.CA1710.api_surface = all
dotnet_code_quality.CA1710.additional_required_suffixes = Collection|Dictionary|Queue|Stack # same rationale as above; i also particularly like the suffixes that aren't based on derivation
dotnet_diagnostic.CA1712.severity = warning
dotnet_code_quality.CA1712.enum_values_prefix_trigger = AnyEnumValue
dotnet_diagnostic.CA1713.severity = warning
dotnet_diagnostic.CA1714.severity = warning
dotnet_code_quality.CA1714.api_surface = all
dotnet_diagnostic.CA1715.severity = warning
dotnet_code_quality.CA1715.api_surface = all
dotnet_diagnostic.CA1716.severity = none # names should be good regardless of what .NET chose to make keywords (in both directions: it needs to be good even if it's not similar to a keyword, and it needs to be good if it *is* (e.g. `object` type in `json` namespace))
dotnet_code_quality.CA1716.api_surface = all
dotnet_diagnostic.CA1717.severity = warning
dotnet_code_quality.CA1717.api_surface = all
# NOTE: there is no CA1718
# NOTE: there is no CA1719
dotnet_diagnostic.CA1720.severity = warning # i think this will be my biggest violation; the issue is that i'm often working on things of a strong-typing, where it *does* make sense to name something `{type1}` and `{type2}`, because the nature of the method is literally translating from one type to another; further, i've been doing a lot of parsing lately where the goal is to take the data and represent it as the .net type, and again, i think the naming makes sense; in these cases, i don't think it's really the issue that hungarian notation has, and it's more of covering gaps in the type system; regardless, i think each of these cases should be justified
dotnet_code_quality.CA1720.api_surface = all
dotnet_diagnostic.CA1721.severity = warning
dotnet_code_quality.CA1721.api_surface = all
# NOTE: there is no CA1722
# NOTE: there is no CA1723
dotnet_diagnostic.CA1724.severity = warning # TODO you can demonstrate how someone could use this for "aliasing" i think
dotnet_diagnostic.CA1725.severity = warning
dotnet_code_quality.CA1725.api_surface = all
# NOTE: there is no CA1726
dotnet_diagnostic.CA1727.severity = warning

### performance

# NOTE: there is no CA1800
# NOTE: there is no CA1801
dotnet_diagnostic.CA1802.severity = warning
dotnet_code_quality.CA1802.api_surface = all
# dotnet_code_quality.CA1802.required_modifiers = none # TODO i couldn't get this to trigger on anything besides `static readonly`; i'm not sure what it's supposed to do
# NOTE: there is no CA1803
# NOTE: there is no CA1804
dotnet_diagnostic.CA1805.severity = warning # the reason *i* like this rule is because doing this potentially hides cs0649
dotnet_diagnostic.CA1806.severity = warning # TODO ide0058 covers a wider range of cases, i think it probably supersedes this
# NOTE: there is no CA1807
# NOTE: there is no CA1808
# NOTE: there is no CA1809
dotnet_diagnostic.CA1810.severity = warning # i've certainly had cases where i needed a static constructor, but those cases would be easy to justify with this rule
# NOTE: there is no CA1811
dotnet_diagnostic.CA1812.severity = warning
dotnet_code_quality.CA1812.ignore_internalsvisibleto = true # internals visible to should generally only be used for testing purposes, so if an internal type is only used to be tested, then the type and its tests should be removed; for cases where the type should remain, they should be easy to justify (since it's a deliberate design choice to share that type across assemblies, but not make the type public)
dotnet_diagnostic.CA1813.severity = warning
dotnet_diagnostic.CA1814.severity = none # i get the point of this rule, but it seems weird; when am i using an array of arrays where they *would* be jagged? and for cases where multidimensional makes sense design-wise, with jagged i need to check the length of the inner arrays, which can have an inconsistency with what is "known" as the size to the design; multi-dimensional remove this ambiguity by letting the compiler know what the lengths are
dotnet_diagnostic.CA1815.severity = warning
dotnet_code_quality.CA1815.api_surface = all
# NOTE: there is no CA1816
# NOTE: there is no CA1817
# NOTE: there is no CA1818































# options

## whitespace

### expression-level preferences

[*.{cs,vb}]
dotnet_style_operator_placement_when_wrapping = beginning_of_line

### identation and spacing

indent_style = space
tab_width = 4
indent_size = 4

### indentation preferences

[*.cs]
csharp_indent_block_contents = true
csharp_indent_braces = false
csharp_indent_case_contents = true
csharp_indent_case_contents_when_block = false#TODO i'm not convinced about this rule, i don't usually write `switch` statements, let alone ones with blocks
csharp_indent_switch_labels = true
csharp_indent_labels = one_less_than_current#TODO i'm not convinced about this rule, i don't usually write `goto` statements

### new line preferences

[*.{cs,vb}]
end_of_line = crlf
insert_final_newline = true
[*.cs]
csharp_new_line_before_open_brace = all#NOTE: these only apply if the entire "node" is not on the same line; so, `class Foo {\r\n}` would *not* be ok, but `class Foo {}` *is* ok
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = true#NOTE: this only applies if the initializer is split across lines at all; you can still have one-liners
csharp_new_line_before_members_in_anonymous_types = true#NOTE: this only applies if the type is split across lines at all; you can still have one-liners
csharp_new_line_between_query_expression_clauses = true#NOTE: this only applies if the query expression is split across lines at all; you can still have one-liners

### space preferences

csharp_space_between_method_declaration_name_and_open_parenthesis = false
csharp_space_between_method_declaration_parameter_list_parentheses = false
csharp_space_between_method_declaration_empty_parameter_list_parentheses = false
csharp_space_between_method_call_name_and_opening_parenthesis = false
csharp_space_between_method_call_parameter_list_parentheses = false
csharp_space_between_method_call_empty_parameter_list_parentheses = false
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_between_parentheses = false
csharp_space_after_cast = false
csharp_space_around_declaration_statements = false
csharp_space_before_open_square_brackets = false
csharp_space_between_empty_square_brackets = false
csharp_space_between_square_brackets = false
csharp_space_after_colon_in_inheritance_clause = true
csharp_space_after_comma = true
csharp_space_after_dot = false
csharp_space_after_semicolon_in_for_statement = true
csharp_space_before_colon_in_inheritance_clause = true
csharp_space_before_comma = false
csharp_space_before_dot = false
csharp_space_before_semicolon_in_for_statement = false
csharp_space_around_binary_operators = before_and_after

### wrapping preferences

csharp_preserve_single_line_blocks = true
csharp_preserve_single_line_statements = false

## code style

### 'using' directive preferences

csharp_using_directive_placement = inside_namespace:warning

### code-block preferences

csharp_prefer_simple_using_statement = false:warning
csharp_prefer_braces = true:warning
csharp_style_namespace_declarations = block_scoped:warning
csharp_style_prefer_method_group_conversion = false:silent
csharp_style_prefer_top_level_statements = false:warning
csharp_style_prefer_primary_constructors = false:silent
csharp_prefer_system_threading_lock = true:warning

### expression-bodied members

csharp_style_expression_bodied_methods = false:silent
csharp_style_expression_bodied_constructors = false:silent
csharp_style_expression_bodied_operators = false:silent
csharp_style_expression_bodied_properties = false:silent
csharp_style_expression_bodied_indexers = false:silent
csharp_style_expression_bodied_accessors = false:silent
csharp_style_expression_bodied_lambdas = true:warning
csharp_style_expression_bodied_local_functions = false:warning

### expression-level preferences

[*.{cs,vb}]
dotnet_style_coalesce_expression = true:warning
dotnet_diagnostic.IDE0270.severity = none#IDE0270: Use coalesce expression
dotnet_style_null_propagation = true:warning
dotnet_style_prefer_is_null_check_over_reference_equality_method = true:warning
dotnet_style_prefer_auto_properties = true:suggestion
#dotnet_style_object_initializer = true:warning
#dotnet_style_collection_initializer = true:silent
dotnet_style_prefer_simplified_boolean_expressions = true:warning
dotnet_style_prefer_conditional_expression_over_assignment = false:silent
dotnet_style_prefer_conditional_expression_over_return = false:silent
dotnet_style_explicit_tuple_names = true:warning
#dotnet_style_prefer_inferred_tuple_names = true:warning
dotnet_style_prefer_inferred_anonymous_type_member_names = true:warning
#dotnet_style_prefer_compound_assignment = false:warning
dotnet_style_prefer_simplified_interpolation = true:warning
#dotnet_style_prefer_collection_expression = when_types_loosely_match:warning
dotnet_style_namespace_match_folder = true:warning
[*.cs]
csharp_style_throw_expression = false:warning
csharp_style_prefer_null_check_over_type_check = true:warning
#csharp_prefer_simple_default_expression = false:warning
csharp_style_prefer_local_over_anonymous_function = true:warning
csharp_style_prefer_index_operator = false:warning
csharp_style_prefer_range_operator = true:suggestion
csharp_style_implicit_object_creation_when_type_is_apparent = false:warning
csharp_style_prefer_implicitly_typed_lambda_expression = true:warning
csharp_style_prefer_tuple_swap = true:suggestion
csharp_style_prefer_unbound_generic_type_in_nameof = true:warning
csharp_style_prefer_utf8_string_literals = true:warning
csharp_style_inlined_variable_declaration = true:warning
csharp_style_deconstructed_variable_declaration = true:warning
csharp_style_unused_value_assignment_preference = unused_local_variable:silent
csharp_style_unused_value_expression_statement_preference = discard_variable:warning

### field preferences

[*.{cs,vb}]
dotnet_style_readonly_field = true:warning

### language keywords vs bcl types preferences

dotnet_style_predefined_type_for_locals_parameters_members = true:warning
dotnet_style_predefined_type_for_member_access = true:warning

### modifier preferences

dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
[*.cs]
csharp_prefer_static_local_function = true:warning
csharp_prefer_static_anonymous_function = true:warning#TODO i have a feeling that i will regret this one because, although it's absolutely the "right" thing to do, linq queries will now have an extra step that i'm not used to reading or writing
csharp_style_prefer_readonly_struct = true:warning
csharp_style_prefer_readonly_struct_member = true:warning

### new line preferences

[*.{cs,vb}]
dotnet_style_allow_multiple_blank_lines_experimental = false:warning
dotnet_style_allow_statement_immediately_after_block_experimental = false:warning
[*.cs]
csharp_style_allow_embedded_statements_on_same_line_experimental = false:warning
csharp_style_allow_blank_lines_between_consecutive_braces_experimental = false:warning
csharp_style_allow_blank_line_after_colon_in_constructor_initializer_experimental = false:warning
csharp_style_allow_blank_line_after_token_in_conditional_expression_experimental = false:warning
csharp_style_allow_blank_line_after_token_in_arrow_expression_clause_experimental = false:silent

### null-checking preferences

csharp_style_conditional_delegate_call = false:silent

### parameter preferences

[*.{cs,vb}]
dotnet_code_quality_unused_parameters = all:warning#NOTE: doesn't count interface implementations, which is probably for the best

### parentheses preferences

dotnet_style_parentheses_in_arithmetic_binary_operators = always_for_clarity:warning#i like the clarity, but i only like it for others; if someone else writes it without them, that's fine, but refactoring is good to have them # TODO that was your previous rationale, but then you realized that this also triggers when some of the components of the expression are method calls and such; we need parentheses for clarity for sure when they aren't simple variables; it might be nice to implement an analyzer that can tell the difference
dotnet_style_parentheses_in_other_binary_operators = always_for_clarity:warning# i think that the boolean operators are less clear, especially when method calls occur and things like that # TODO also check the above rationale about method calls
dotnet_style_parentheses_in_relational_binary_operators = never_if_unnecessary:suggestion # for sure people don't have a good intuition of the precedence for these operators, so we should require them
dotnet_style_parentheses_in_other_operators = never_if_unnecessary:warning # i don't know what all of the operators are here, but `.` is one of them, and parens for that is awful; making it a suggestion to remove them when unnecessary because they really should be *added* when clarity is poor for a specific situation

### pattern matching preferences

[*.cs]
csharp_style_prefer_switch_expression = true:suggestion # this is so limited in use, it's fine to suggest to move me towards c# 8 (and to add in refactors), but it's not something to shoehorn in
csharp_style_prefer_pattern_matching = false:warning # i really wish i could make this warn *against* the pattern matching stuff
csharp_style_pattern_matching_over_is_with_cast_check = true:warning # great because it avoids hard casts; mistakes can be made while *maintaining*, but this was the compiler handles all of it
csharp_style_pattern_matching_over_as_with_null_check = true:warning # great because it makes clear a pattern that used exist, and sometimes wasn't always followed
csharp_style_prefer_not_pattern = true:suggestion # suggestion for discovery; it's way easier to type the new way, but both are fine, even in terms of readability
csharp_style_prefer_extended_property_pattern = true:warning # i hate this syntax, but if you're going to use it, i think this is good because the rule only applies for cases where there is a single "inner" check (TODO find the right names to refer to these constructs)

### this. and Me. preferences

[*.{cs,vb}]
dotnet_style_qualification_for_field = true:warning
dotnet_style_qualification_for_event = true:warning
dotnet_style_qualification_for_method = true:warning
dotnet_style_qualification_for_property = true:warning

### var preferences

[*.cs]
csharp_style_var_elsewhere = true:warning
csharp_style_var_for_built_in_types = true:warning
csharp_style_var_when_type_is_apparent = true:warning
csharp_prefer_simple_default_expression = true:suggestion

## naming style

[*.{cs,vb}]
dotnet_naming_rule.interface_should_be_begins_with_i.severity = warning
dotnet_naming_rule.interface_should_be_begins_with_i.symbols = interface
dotnet_naming_rule.interface_should_be_begins_with_i.style = begins_with_i

dotnet_naming_rule.non_field_members_should_be_pascal_case.severity = warning
dotnet_naming_rule.non_field_members_should_be_pascal_case.symbols = non_field_members
dotnet_naming_rule.non_field_members_should_be_pascal_case.style = pascal_case

dotnet_naming_rule.types_should_be_pascal_case.severity = warning
dotnet_naming_rule.types_should_be_pascal_case.symbols = types
dotnet_naming_rule.types_should_be_pascal_case.style = pascal_case

## analyzers

### correctness

dotnet_diagnostic.RS1010.severity = none #todo i don't know enough about this to make a decision # TODO should you make something an *error* to indicate to yourself that you didn't fully investigate? that way you'll be notified to investigate it when you have relevant code?
dotnet_diagnostic.RS1011.severity = none #todo i don't know enough about this to make a decision
dotnet_diagnostic.RS1016.severity = none #todo i don't know enough about this to make a decision

## options that are not present in the UI

# naming style definitions

dotnet_naming_style.pascal_case.required_prefix = 
dotnet_naming_style.pascal_case.required_suffix = 
dotnet_naming_style.pascal_case.word_separator = 
dotnet_naming_style.pascal_case.capitalization = pascal_case

dotnet_naming_style.begins_with_i.required_prefix = I
dotnet_naming_style.begins_with_i.required_suffix = 
dotnet_naming_style.begins_with_i.word_separator = 
dotnet_naming_style.begins_with_i.capitalization = pascal_case



































# Type members
dotnet_hide_advanced_members = false
dotnet_member_insertion_location = with_other_members_of_the_same_kind
dotnet_property_generation_behavior = prefer_throwing_properties

# Symbol search
dotnet_search_reference_assemblies = true

#### .NET Coding Conventions ####

# Organize usings
dotnet_separate_import_directive_groups = true
dotnet_sort_system_directives_first = true
file_header_template = unset


# Expression-level preferences
dotnet_prefer_system_hash_code = true






dotnet_style_prefer_foreach_explicit_cast_in_source = when_strongly_typed





# Suppression preferences
dotnet_remove_unnecessary_suppression_exclusions = none


csharp_preferred_modifier_order = public,private,protected,internal,file,static,extern,new,virtual,abstract,sealed,override,readonly,unsafe,required,volatile,async



dotnet_diagnostic.IDE0055.severity = warning





# Symbol specifications

dotnet_naming_symbols.interface.applicable_kinds = interface
dotnet_naming_symbols.interface.applicable_accessibilities = public, internal, private, protected, protected_internal, private_protected
dotnet_naming_symbols.interface.required_modifiers = 

dotnet_naming_symbols.types.applicable_kinds = class, struct, interface, enum
dotnet_naming_symbols.types.applicable_accessibilities = public, internal, private, protected, protected_internal, private_protected
dotnet_naming_symbols.types.required_modifiers = 

dotnet_naming_symbols.non_field_members.applicable_kinds = property, event, method
dotnet_naming_symbols.non_field_members.applicable_accessibilities = public, internal, private, protected, protected_internal, private_protected
dotnet_naming_symbols.non_field_members.required_modifiers = 
dotnet_style_object_initializer = true:suggestion
dotnet_style_collection_initializer = true:suggestion
dotnet_style_prefer_inferred_tuple_names = true:suggestion
dotnet_style_prefer_compound_assignment = true:suggestion
dotnet_style_prefer_collection_expression = when_types_loosely_match:suggestion
