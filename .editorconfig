# https://learn.microsoft.com/en-us/dotnet/fundamentals/code-analysis/categories

root = true

# rules

## code quality

### design

[*.{cs,vb}]
dotnet_diagnostic.CA1000.severity = warning # TODO i agree with the purpose of the rule; i'm concerned about false positives; and if the method call is *supposed* to be flagged, that's just unavoidable design-wise, so i would set this rule to `none` if that's the case; and regarding the case it *does* catch, i think those situations should be caught in unit testing because the code will be painful to write
dotnet_code_quality.CA1000.api_surface = all # TODO write down at some point that you apply things to all api surfaces because, if it's good for my customer, it's good for me too
dotnet_diagnostic.CA1001.severity = warning # you better have a good reason to not dispose things
dotnet_diagnostic.CA1002.severity = warning
dotnet_code_quality.CA1002.api_surface = all
dotnet_diagnostic.CA1003.severity = warning
dotnet_code_quality.CA1003.api_surface = all
# NOTE: there is no CA1004
dotnet_diagnostic.CA1005.severity = warning
dotnet_code_quality.CA1005.api_surface = all
# NOTE: there is no CA1006
# NOTE: there is no CA1007
dotnet_diagnostic.CA1008.severity = warning # TODO i agree with this for flags enums (and would be fine with a reasonably justified exception or two); for non-flags, the description *as written* i don't really agree with because i think there are plenty of cases where the `0` member doesn't exist or shouldn't be called "none"; however, the rule doesn't trigger if a `0` member is defined that is called something else; so, if the rule triggers because there is no "0" member, that's actually an implementation detail and design leak; the members should all be shifted to reach 0; 
dotnet_code_quality.CA1008.api_surface = all
# NOTE: there is no CA1009
dotnet_diagnostic.CA1010.severity = warning # TODO i'm good with this one because it doesn't trigger if you implement the non-generic *and* the generic
dotnet_code_quality.CA1010.api_surface = all
# NOTE: there is no CA1011
dotnet_diagnostic.CA1012.severity = warning
dotnet_code_quality.CA1012.api_surface = all
# NOTE: there is no CA1013
dotnet_diagnostic.CA1014.severity = none # TODO you're not clscompliant right now probably, but it wouldn't hurt to do so; but not right now
# NOTE: there is no CA1015
dotnet_diagnostic.CA1016.severity = none # TODO i don't know if you do this with nuget packages; figure that out
dotnet_diagnostic.CA1017.severity = none # TODO i don't know anything about this
dotnet_diagnostic.CA1018.severity = warning
dotnet_diagnostic.CA1019.severity = none # TODO seems like overkill; the parameters maybe be combined in a way that is still useful; if the parameter is needed, the attribute itself won't be useful, and who is defining a custom attribute type without also provided code that leverages it?
# NOTE: there is no CA1020
dotnet_diagnostic.CA1021.severity = warning # TODO a key to this one is that the "try" naming convention avoids triggering the rule; i'm not 100% sure i like this rule though TODO i actually really don't like it because this one doesn't actually trigger for `ref` parameters, it looks like; that's rule ca1045
# NOTE: there is no CA1022
# NOTE: there is no CA1023
dotnet_diagnostic.CA1024.severity = warning
dotnet_code_quality.CA1024.api_surface = all
# NOTE: there is no CA1025
# NOTE: there is no CA1026
dotnet_diagnostic.CA1027.severity = warning
dotnet_code_quality.CA1027.api_surface = all
dotnet_diagnostic.CA1028.severity = none # TODO this rule seems dumb to me; struct size is dependent on fields which can be enums, so having smaller enums makes a difference even if the enum itself has no specific performance benefits; and it's definitely possible to have an enum with 33 values, so going larger also makes sense; i suppose the case could be made that if someone wants to use a different base, they should justify it instead of doing it "just because"
dotnet_code_quality.CA1028.api_surface = all
# NOTE: there is no CA1029
dotnet_diagnostic.CA1030.severity = warning # TODO the rule makes sense to me, but i have no experience
dotnet_code_quality.CA1030.api_surface = all
dotnet_diagnostic.CA1031.severity = warning
dotnet_diagnostic.CA1032.severity = warning # TODO although i agree with this greatly, i think i often violate it; maybe it shouldn't apply to interfaces or something?
dotnet_diagnostic.CA1033.severity = warning # TODO so i guess the point is that the derived type "has an instance" of the interface (from the base type), but has no way to call the method from the interface, and if they try to be clever, they get a stackoverflow; first of all, the stack overflow bug should be caught during unit testing; but otherwise, i guess it makes sense to have a protected member; this is a neat trick though that i want to remember, i can have a publicly exposed method that's not available to derived types; i wonder when that might be useful?
dotnet_diagnostic.CA1034.severity = warning # TODO i agree with this, but i'm going to break it a lot with discriminated unions; i wonder if there's a way to extend the rule to ignore nestsed types that derive the containing type and the containing type is abstract and has a private constructor?
# NOTE: there is no CA1035
dotnet_diagnostic.CA1036.severity = warning
dotnet_code_quality.CA1036.api_surface = all
# NOTE: there is no CA1037
# NOTE: there is no CA1038
# NOTE: there is no CA1039
dotnet_diagnostic.CA1040.severity = none # TODO i don't agree with the rule description; attributes are *not* the best way to mark something; consider, for example, generic type constraints
dotnet_code_quality.CA1040.api_surface = all
dotnet_diagnostic.CA1041.severity = warning
dotnet_code_quality.CA1041.api_surface = all
# NOTE: there is no CA1042
dotnet_diagnostic.CA1043.severity = none # TODO i'm not clear at all why this restriction is recommended
dotnet_code_quality.CA1043.api_surface = all
dotnet_diagnostic.CA1044.severity = warning # TODO i can't imagine who is trying to have write-only properties, except for people who actually know what they are doing and are just going to need to suppress this rule; but i guess those folks with have a reasonable justification, so might as well have the rule
dotnet_code_quality.CA1044.api_surface = all
dotnet_diagnostic.CA1045.severity = warning # absolutely, ref parameters are bad; however, i think this should account for ref fields of ref structs, and also parameters that are ref structs
dotnet_code_quality.CA1045.api_surface = all
dotnet_diagnostic.CA1046.severity = warning # despite the rule about using `is null` for null checks, we don't control others' code and shouldn't assume that they follow best practice, so we don't want to accidentally overload `==` in a way that breaks null checks
dotnet_code_quality.CA1046.api_surface = all
dotnet_diagnostic.CA1047.severity = warning
dotnet_code_quality.CA1047.api_surface = all
# NOTE: there is no CA1048
# NOTE: there is no CA1049
dotnet_diagnostic.CA1050.severity = warning
dotnet_code_quality.CA1050.api_surface = all
