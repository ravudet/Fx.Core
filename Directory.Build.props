<Project>
  <PropertyGroup>
    <LangVersion>13.0</LangVersion>
  </PropertyGroup>

  <!--nuget build properties-->
  <PropertyGroup>
    <PackageId>$(MSBuildProjectName)</PackageId>
    <NoPackageAnalysis>false</NoPackageAnalysis>
    <PackageOutputPath>$(MSBuildThisFileDirectory)\packages</PackageOutputPath>
  </PropertyGroup>

  <!--nuget package properties-->
  <PropertyGroup>
    <Authors>ravudet</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/ravudet/Fx.Core</RepositoryUrl>
    <VersionSuffix Condition="'$(Fx_Release)' != 'true' and '$(DesignTimeBuild)' != 'true'">$([System.DateTime]::Now.Ticks)</VersionSuffix>
  </PropertyGroup>

</Project>