<Project Sdk="MSTest.Sdk/3.6.4">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace />
    <UseVSTest>true</UseVSTest>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="testhost.dll.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="_resources\**" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\Fx.Analyzers.GlobalConfig.Tests\_resources\FX0001.cs" Link="_resources\FX0001.cs" />
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.12" />
  </ItemGroup>
  
  <ItemGroup>
    <ProjectReference Include="..\Fx.Core\Fx.Core.csproj" />
  </ItemGroup>
  
  <Target Name="UpdateOutputConfig" AfterTargets="Build">
    <XmlPoke XmlInputPath="C:\github\Fx.Core\source\PackageTests\bin\Debug\net9.0\testhost.dll.config" Query="/configuration/appSettings/add[@key='MyCustomKey']/@value" Value="$(PackageOutputPath)" />
  </Target>

</Project>
