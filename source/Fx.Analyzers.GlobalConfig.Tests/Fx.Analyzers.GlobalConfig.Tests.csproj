<Project Sdk="MSTest.Sdk/3.6.4">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace />
    <UseVSTest>true</UseVSTest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.CodeFix.Testing" Version="1.1.4" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fx.Analyzers\Fx.Analyzers.csproj" />
    <ProjectReference Include="..\Fx.Core\Fx.Core.csproj" />
    <ProjectReference Include="..\Fx.Microsoft_CodeAnalysis\Fx.Microsoft_CodeAnalysis.csproj" />
    <ProjectReference Include="..\Fx.Microsoft_CodeAnalysis_Analyzer_Testing+MSTest_TestFramework\Fx.Microsoft_CodeAnalysis_Analyzer_Testing+MSTest_TestFramework.csproj" />
    <ProjectReference Include="..\Fx.Microsoft_CodeAnalysis_Analyzer_Testing\Fx.Microsoft_CodeAnalysis_Analyzer_Testing.csproj" />
  </ItemGroup>
  
  <ItemGroup>
    <Content Include="testhost.dll.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  
  <ItemGroup>
    <Compile Include="_resources\**" />
    <EmbeddedResource Include="..\Fx.Analyzers.GlobalConfig\content\Fx.Analyzers.GlobalConfig.globalconfig" Link="Fx.Analyzers.GlobalConfig.globalconfig" />
  </ItemGroup>
  
  <Target Name="RemoveResources" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <Compile Remove="_resources\**" />
      <EmbeddedResource Include="_resources\**" />
    </ItemGroup>
  </Target>

  <Target Name="UpdateOutputConfig" AfterTargets="Build">
    <XmlPoke XmlInputPath="$(OutputPath)\testhost.dll.config" Query="/configuration/appSettings/add[@key='PackageSourceDirectory']/@value" Value="$(PackageOutputPath)" />
  </Target>

</Project>
